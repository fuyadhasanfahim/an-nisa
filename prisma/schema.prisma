generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  role          Role     @default(user)
  banned        Boolean  @default(false)
  createdAt     DateTime
  updatedAt     DateTime

  sessions     Session[]
  accounts     Account[]
  orders       Order[]
  invoices     Invoice[]
  customers    CustomerProfile?
  customOrders CustomOrder[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Product {
  id                 String   @id
  name               String
  slug               String   @unique
  sku                String?  @unique
  description        String?
  priceCents         Int
  discountPriceCents Int?
  currency           String   @default("BDT")
  images             String[]
  isActive           Boolean  @default(true)
  stockQuantity      Int      @default(0)
  trackInventory     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems OrderItem[]

  @@map("product")
}

enum PaymentCollectedVia {
  cash
  bkash
  nagad
  card
  bank_transfer
  other
}

enum PaymentMethod {
  cod
  bkash
  nagad
  card
  bank_transfer
  other
}

enum PaymentStatus {
  pending
  paid
  failed
}

model Order {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  status     String   @default("pending")
  subtotalCents    Int
  discountCents    Int            @default(0)
  shippingFeeCents Int            @default(0)
  totalCents       Int
  currency         String         @default("BDT")
  paymentMethod           PaymentMethod         @default(cod)
  paymentStatus           PaymentStatus         @default(pending)
  /// Reference / trx id recorded when COD (or other) payment is collected.
  paymentId               String                @default("")
  /// Channel used when taking payment (cash, mobile wallet, etc.).
  paymentCollectedVia     PaymentCollectedVia   @default(cash)
  shippingPhone    String?
  shippingAddress  String?
  shippingCity     String?
  shippingCountry  String         @default("BD")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items   OrderItem[]
  invoice Invoice?

  @@index([userId])
  @@map("order")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int      @default(1)
  unitCents Int
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model Invoice {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  number     String   @unique
  totalCents Int
  currency   String   @default("BDT")
  issuedAt   DateTime @default(now())

  @@index([userId])
  @@map("invoice")
}

model CustomOrder {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  details   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("custom_order")
}

model Expense {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String?
  amountCents  Int
  currency     String   @default("BDT")
  spentAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("expense")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable human-readable id shown in admin (e.g. customer-48291).
  publicCustomerId String? @unique
  phone     String?
  address   String?
  city      String?
  country   String?  @default("BD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profile")
}
